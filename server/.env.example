# ============================================================
# AI Scrum Assistant — Server Environment Variables
# ============================================================
# Copy this to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# ── Server ──
PORT=2000

# ── MongoDB ──
MONGODB_URI=mongodb://mongo:27017
DB_NAME=jira_app

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── ChromaDB ──
CHROMA_URL=http://chroma:8000

# ── Embedding Service ──
EMBEDDING_SERVICE_URL=http://localhost:8001

# ── JWT ──
JWT_SECRET=change-me-to-a-random-secret

# ── Atlassian OAuth (required for Jira integration) ──
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:5173/oauth/callback
FRONTEND_SUCCESS_URL=http://localhost:5173/oauth/success

# ── Frontend URL (for CORS) ──
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins (overrides FRONTEND_URL if set)
# CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# ── Server URL (for Swagger docs) ──
# SERVER_URL=https://api.yourdomain.com

# ── LLM API Keys (at least one required) ──
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ── Jira Basic Auth (optional, fallback for non-OAuth) ──
JIRA_HOST=
JIRA_EMAIL=
JIRA_API_TOKEN=
